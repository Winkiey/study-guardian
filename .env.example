# ============================================================
# 学习守护平台 — 环境变量示例
# 复制成 .env 后按需修改。所有项都有默认值，可以全部留空先跑起来。
# .env 已被 .gitignore 忽略，不会泄露你的密钥。
# ============================================================

# 服务监听端口
# 默认 3081。选这个数字是为了避开一些常见占用（3000/8000/8080/3080）。
PORT=3081

# 监听地址。127.0.0.1 = 只有本机能访问（最安全，默认）
# 想让手机在同一个 Wi-Fi 下访问，改成 0.0.0.0
HOST=127.0.0.1

# 会话签名密钥。留空则首次启动时自动生成并写入 data/secret.key
SESSION_SECRET=

# 网站标题，会显示在浏览器标签和 PWA 图标上
APP_NAME=学习守护

# 时区，用于课表与作业 DDL 计算
TZ=Asia/Shanghai

# ------------------------------------------------------------
# Office 文件转 PDF（PPT/Word/Excel 在线预览用）
# 留空 = 自动探测本机的 LibreOffice / Microsoft Office / WPS
# 也可以手动指定 soffice 可执行文件路径，例如：
#   C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=

# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=200

# 提醒调度器的检查间隔（秒）。默认 60 秒扫一次待发提醒。
SCHEDULER_INTERVAL_SEC=60

# 是否在服务启动时立刻跑一次提醒检查
SCHEDULER_RUN_ON_START=true

# 是否启用 Office→PDF 自动转换。关掉可节省 CPU，
# 关掉后 PPT/Word 会用内置解析器渲染成网页版预览。
ENABLE_OFFICE_CONVERT=true
