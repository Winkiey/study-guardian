# ============================================================
# 学习守护平台 — 环境变量示例
# 复制成 .env 后按需修改。所有项都有默认值，可以全部留空先跑起来。
# .env 已被 .gitignore 忽略，不会泄露你的密钥。
# ============================================================

# 服务监听端口
# 默认 3081。选这个数字是为了避开一些常见占用（3000/8000/8080/3080）。
PORT=3081

# 监听地址。127.0.0.1 = 只有本机能访问（最安全，默认）
# 想让手机在同一个 Wi-Fi 下访问，改成 0.0.0.0
HOST=127.0.0.1

# 会话签名密钥。留空则首次启动时自动生成并写入 data/secret.key
SESSION_SECRET=

# 网站标题，会显示在浏览器标签和 PWA 图标上
APP_NAME=学习守护

# 时区，用于课表与作业 DDL 计算
TZ=Asia/Shanghai

# ------------------------------------------------------------
# Office 文件转 PDF（PPT/Word/Excel 在线预览用）
# 留空 = 自动探测本机的 LibreOffice / Microsoft Office / WPS
# 也可以手动指定 soffice 可执行文件路径，例如：
#   C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=

# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=200

# 提醒调度器的检查间隔（秒）。默认 60 秒扫一次待发提醒。
SCHEDULER_INTERVAL_SEC=60

# 是否在服务启动时立刻跑一次提醒检查
SCHEDULER_RUN_ON_START=true

# 是否启用 Office→PDF 自动转换。关掉可节省 CPU，
# 关掉后 PPT/Word 会用内置解析器渲染成网页版预览。
ENABLE_OFFICE_CONVERT=true

# ------------------------------------------------------------
# 限流
#
# 跑在「按流量计费」的云服务器上时，限流就是账单的刹车：
# 没有它，端口扫描、暴力试密码、反复拉静态资源都会直接变成钱。
# 实测 5Mbps 带宽被打满一整天约 ¥43，100Mbps 约 ¥864。
#
# 普通请求：默认 300/分钟。打开一个 71 页的课件就要 70 多次请求，
#   所以不能设太小，否则会误伤自己。
RATE_LIMIT_PER_MIN=300
#
# 登录接口：默认 1/分钟（允许突发 10 次）。
#   这是唯一能「试出密码」的入口，而本项目没有登录失败锁定，
#   所以必须在这里兜住。1 分钟 1 次对人是够的，对脚本是致命的。
RATE_LIMIT_AUTH_PER_MIN=1
#
# 两个都设成 0 = 关闭限流（跑压测时用）

# ------------------------------------------------------------
# 邀请码 —— 注册闸门
#
# 这个站的数据是「一人一份、互不干扰」的，所以谁都能注册就等于
# 谁都能往你的服务器上塞文件（按流量计费）和占磁盘。
#
# 填了 = 别人注册时必须填对邀请码才能建号。
# 留空 = 关闭注册（只有站点还没建任何账号时的「第一个管理员」例外）。
#
# 邀请码就是一串普通文字，自己取个好记又不容易猜的即可，
# 例如 INVITE_CODE=dufe-2025-vip
#
# 想临时开放注册：填上 / 改掉这里，然后重启服务（pm2 restart study-guardian）。
# 想关掉注册：清空这一行再重启。
INVITE_CODE=

# ------------------------------------------------------------
# 是否信任反向代理传来的 X-Forwarded-For
#
# ⚠️ 默认 false，而且别随便打开：
# 打开之后客户端靠伪造这个头就能绕过限流（每次换一个 IP 就换一个新桶）。
# 只有确实部署在 Caddy / Nginx 后面时才设成 true，
# 那时取的是 XFF 的最后一个值 —— 代理亲眼看到的那个真实 IP。
TRUST_PROXY=false
